digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.3, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить коллекцию продаж, порог min и limit" ,shape=parallelogram,fillcolor="#E4DFEC",color="#7030A0"];
n2 [label="Сформировать stream: sales.stream()"];
n3 [label="A1 Отфильтровать: filter(s -> s.amount() >= min),\nдля крупных сделок min = LARGE_DEAL_MIN = 25 000"];
n4 [label="Отсортировать: sorted(BY_AMOUNT_DESC_THEN_ID),\nсумма по убыванию, при равенстве по id"];
n5 [label="Выбрать терминальную операцию: limit(limit).toList(),\nдля максимума max(Comparator), для сумм groupingBy"];
n6 [label="Результат найден" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n7 [label="Вернуть новый список, новый Map\nили Optional со значением"];
n8 [label="Вернуть Optional.empty или пустую коллекцию"];
start -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4;
n4 -> n5;
n5 -> n6;
n6 -> n7 [label="да"];
n6 -> n8 [label="нет"];
n7 -> end;
n8 -> end;
}
