digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.5];
node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
a [label="{SalesAnalyticsService|+ LARGE_DEAL_MIN = 25000 double\l+ BY_AMOUNT_DESC_THEN_ID Comparator[Sale]\l|+ topSales(List[Sale], double, int) List[Sale]\l+ maxSale(List[Sale]) Optional[Sale]\l+ totalsByManager(List[Sale]) Map[String,Double]\l+ averageByRegion(List[Sale], String) double\l+ largeSales(List[Sale]) List[Sale]\l+ isLarge(Sale) boolean\l}"];
s [label="{«record» Sale|- id String\l- manager String\l- region String\l- amount double\l|+ id(), manager(), region(), amount()\l}"];
a -> s [label="processes 0..*",style=dashed,arrowhead=open];
}
